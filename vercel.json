{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=300"},
        {"key": "X-CDN", "value": "Vercel-Edge"},
        {"key": "X-Redis-Cache", "value": "HIT"}
      ]
    }
  ],
  "rewrites": [{"source": "/(.*)", "destination": "/index.html"}]
}